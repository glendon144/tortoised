#!/usr/bin/env bash
set -euo pipefail

PORT="${TORTOISED_PORT:-8767}"
PIDS="$(lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true)"

if [ -z "$PIDS" ]; then
    echo "No tortoised listener found on port $PORT"
    exit 0
fi

echo "Stopping tortoised process(es): $PIDS"
kill $PIDS 2>/dev/null || true
sleep 1

PIDS_LEFT="$(lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true)"
if [ -n "$PIDS_LEFT" ]; then
    echo "Force stopping tortoised process(es): $PIDS_LEFT"
    kill -9 $PIDS_LEFT 2>/dev/null || true
fi
